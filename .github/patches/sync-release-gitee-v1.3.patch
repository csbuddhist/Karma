+def fetch_pages(url, gitee=False):
+    items = []
+    page = 1
+    while page <= 1000:
+        params = {'page': page, 'per_page': 100}
+        if gitee:
+            params['access_token'] = gitee_access_token
+        payload = request_json('get', url, params=params, headers={} if gitee else github_headers())
+        if not isinstance(payload, list):
+            raise RuntimeError('Expected an API list response')
+        items.extend(payload)
+        if len(payload) < 100:
+            return items
+        page += 1
+    raise RuntimeError('Pagination limit exceeded')
+
