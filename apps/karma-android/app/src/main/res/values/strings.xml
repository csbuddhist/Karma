    <string name="setup_title">Set the administrator password</string>
    <string name="setup_explanation">This password is required to change settings, stop protection or uninstall Karma. Use at least 10 characters, and keep it away from the person using this phone.</string>
    <string name="privacy_promise">All checks run on this phone. Karma does not upload screen content, never saves screenshots, and its log records only app names, reasons and times.</string>
