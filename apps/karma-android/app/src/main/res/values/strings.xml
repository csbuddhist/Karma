    <string name="app_name" translatable="false">Karma</string>
    <string name="accessibility_service_label">Karma Protection</string>
    <string name="accessibility_service_description">Karma checks what is on screen, entirely on this phone, and closes apps that show explicit images or blocked content. Screenshots are never saved or uploaded. Turning this off requires the administrator password.</string>

